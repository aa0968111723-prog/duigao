+/**
+ * touch_whiteboard_node（0014）在版本倒退時 raise 'stale-write'：別人已存了
+ * 更新的節點。這不是可重試的暫時性失敗 — 重放同一份舊 payload 只會永遠
+ * 409（audit F10 的殭屍佇列）。
+ */
+export function isStaleWrite(err: unknown): boolean {
+  return messageOf(err).includes("stale-write");
+}
