# Cloud rooms (PR #12). Leave these blank to run the app in local-only mode
# (IndexedDB + PeerJS best-effort), which is exactly the current behaviour.
#
# Fill them in with your Supabase project's values to enable persistent,
# shareable multi-user rooms. Only the PUBLISHABLE (anon) key belongs here —
# never put the service-role key in the frontend or commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set`; never put
# these in VITE_* or expose them to the browser).
DUIGAO_AGENT_PROVIDER=tku-zen-agent
TKU_ZEN_AGENT_URL=
AI_OS_AGENT_URL=
DUIGAO_AGENT_SHARED_SECRET=
# Set to true only when the selected context provider forwards private asset
# understanding to an external model. The Edge Function blocks disallowed
# assets before the provider request.
DUIGAO_AGENT_PROVIDER_EXTERNAL=true
# Optional approved analysis provider; empty means metadata/local Tier 1 only.
DUIGAO_ANALYSIS_PROVIDER_EXTERNAL=true
# Set true only when TKU_ZEN_AGENT_URL points to an approved private/internal
# analysis service. It allows processing ai_readable assets whose contents are
# not permitted to leave the approved boundary; it never changes Room Context.
DUIGAO_INTERNAL_ANALYSIS_ENABLED=false
